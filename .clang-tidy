# Defect classes only, style checks off. The Core Guidelines Bounds profile is off: a C ABI passes
# arrays as a pointer and a length. Each disabled check below was run over the tree and every hit
# was a false positive or intended.
# Only flux2's own headers: the vendored nanobind under thirdparty/ is not ours to change.
HeaderFilterRegex: '.*/flux2_[a-z]+/include/.*'
Checks: >
  -*,
  bugprone-*,
  concurrency-*,
  performance-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-pro-bounds-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-branch-clone,
  -bugprone-switch-missing-default-case,
  -bugprone-empty-catch,
  -bugprone-unchecked-optional-access,
  -bugprone-unchecked-string-to-number-conversion,
  -bugprone-return-const-ref-from-parameter,
  -concurrency-mt-unsafe,
  -performance-no-int-to-ptr,
  -performance-enum-size,
  -performance-inefficient-string-concatenation
CheckOptions:
  performance-unnecessary-value-param.AllowedTypes: '^::nanobind::'
