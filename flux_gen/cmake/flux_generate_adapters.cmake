# flux_generate_adapters(<.msg files, relative to the current source dir>...)
#
# Generates, per message, a C++ header and a Python module that read and write the flat frame
# layout flux_gen computes, and installs both:
#
#   include/<pkg>/flux/<snake>.hpp  ->  <pkg>::flux_msg::<Msg>
#   <pkg>_flux/<snake>.py          ->  <pkg>_flux.<snake>.<Msg>, also <pkg>_flux.<Msg>
#
# A message this package also passes to rosidl_generate_interfaces() gets the ROS bridge pair
# beside them (<snake>_ros.hpp, <snake>_ros.py), so call that first. A message without rosidl
# types gets no bridge: it could not include or import them.
#
# Opt-in per message, like the rest of flux -- listing a .msg here does not change how the
# package's normal ROS interfaces are built. The headers are emitted as plain text and compiled
# by whoever includes them, so a message package needs no build dependency on flux_cpp; consumers
# include the header and link flux_cpp themselves. A target of this package that includes one
# links ${PROJECT_NAME}_flux_adapters, which adds the include directory and generates first.
#
# A schema's layout and fingerprint depend on every nested type it reads, so the generator writes
# a depfile naming them. Editing a nested .msg regenerates its carriers; without that a stale
# adapter is not a build error but a fingerprint that no longer matches its peer at runtime.
#
# A macro, not a function, for the same reason rosidl_generate_interfaces is one:
# ament_export_include_directories() appends to a variable in its caller's domain, and a function
# would swallow it -- the headers would install but no consumer could find them. Locals are
# _flux_-prefixed since a macro shares the caller's domain.

# One message's generator command, its output files returned in <outputs>. The file names come
# from flux_gen --list, so the naming rules live in the generator alone. flux_std_adapters calls
# it too.
function(_flux_generate pkg msg ros root outputs)
  set(_flags --pkg ${pkg} --msg "${msg}" --out-cpp "${root}/include" --out-py "${root}/python")
  if(NOT ros)
    list(APPEND _flags --no-ros)
  endif()
  # A new generator may name files differently: configure again when it changes.
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${FLUX_GEN_EXECUTABLE}")
  execute_process(
    COMMAND "${FLUX_GEN_EXECUTABLE}" ${_flags} --list
    OUTPUT_VARIABLE _files
    RESULT_VARIABLE _rc
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "flux_gen --list failed for ${msg}")
  endif()
  string(REPLACE "\n" ";" _files "${_files}")
  # Two messages writing one file would keep whichever ran last: Foo's bridge foo_ros.* is the
  # adapter of a message FooRos.
  get_property(_taken DIRECTORY PROPERTY FLUX_GEN_OUTPUTS)
  foreach(_file IN LISTS _files)
    if(_file IN_LIST _taken)
      message(FATAL_ERROR
        "flux_generate_adapters: ${msg} would write ${_file}, which another message writes too: "
        "rename one of them")
    endif()
  endforeach()
  set_property(DIRECTORY APPEND PROPERTY FLUX_GEN_OUTPUTS ${_files})

  get_filename_component(_name "${msg}" NAME_WE)
  set(_dep "${root}/${pkg}_${_name}.d")
  add_custom_command(
    OUTPUT ${_files}
    COMMAND "${FLUX_GEN_EXECUTABLE}" ${_flags} --depfile "${_dep}"
    # The generator is an input: an emitter edit or a fingerprint version bump must regenerate
    # every consumer, or a stale adapter is a fingerprint that no longer matches its peer.
    DEPENDS "${msg}" "${FLUX_GEN_EXECUTABLE}"
    DEPFILE "${_dep}"
    COMMENT "flux_gen: ${pkg}/${_name}"
    VERBATIM)
  set(${outputs} ${_files} PARENT_SCOPE)
endfunction()

macro(flux_generate_adapters)
  # ARGN is not a real variable inside a macro -- it only exists as ${ARGN} -- so capture it.
  set(_flux_msgs "${ARGN}")
  if(NOT _flux_msgs)
    message(FATAL_ERROR "flux_generate_adapters() called without any .msg files")
  endif()

  find_package(Python3 REQUIRED COMPONENTS Interpreter)

  set(_flux_root "${CMAKE_CURRENT_BINARY_DIR}/flux_adapters")
  set(_flux_outputs "")
  set(_flux_init "# generated by flux_generate_adapters -- do not edit.\n")

  foreach(_flux_msg IN LISTS _flux_msgs)
    get_filename_component(_flux_name "${_flux_msg}" NAME_WE)
    set(_flux_ros OFF)
    foreach(_flux_idl IN LISTS rosidl_generate_interfaces_ABS_IDL_FILES)
      if(_flux_idl MATCHES "/msg/${_flux_name}\\.idl$")
        set(_flux_ros ON)
      endif()
    endforeach()
    _flux_generate(${PROJECT_NAME} "${CMAKE_CURRENT_SOURCE_DIR}/${_flux_msg}" ${_flux_ros}
      "${_flux_root}" _flux_files)
    list(APPEND _flux_outputs ${_flux_files})

    # The Python module is the first .py listed. The package exports the message class alone:
    # star-importing every module let one message's constants and View replace another's.
    set(_flux_py ${_flux_files})
    list(FILTER _flux_py INCLUDE REGEX "\\.py$")
    list(GET _flux_py 0 _flux_py)
    get_filename_component(_flux_mod "${_flux_py}" NAME_WE)
    string(APPEND _flux_init "from .${_flux_mod} import ${_flux_name}  # noqa: F401\n")
  endforeach()

  file(GENERATE
    OUTPUT "${_flux_root}/python/${PROJECT_NAME}_flux/__init__.py"
    CONTENT "${_flux_init}")

  add_custom_target(${PROJECT_NAME}_flux_generate ALL DEPENDS ${_flux_outputs})
  add_library(${PROJECT_NAME}_flux_adapters INTERFACE)
  target_include_directories(${PROJECT_NAME}_flux_adapters
    INTERFACE "$<BUILD_INTERFACE:${_flux_root}/include>")
  add_dependencies(${PROJECT_NAME}_flux_adapters ${PROJECT_NAME}_flux_generate)

  # rosidl puts a package's headers at include/<pkg>/<pkg>/..., so the exported include dir is
  # include/<pkg> and an adapter resolves as <pkg>/flux/<name>.hpp. Matching that layout keeps
  # one export correct whether or not the package also generates ROS interfaces.
  install(DIRECTORY "${_flux_root}/include/" DESTINATION "include/${PROJECT_NAME}")
  install(DIRECTORY "${_flux_root}/python/"
    DESTINATION "lib/python${Python3_VERSION_MAJOR}.${Python3_VERSION_MINOR}/site-packages")
  ament_export_include_directories("include/${PROJECT_NAME}")
endmacro()
