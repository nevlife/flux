<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>flux_py</name>
  <version>0.0.0</version>
  <description>
    flux Python binding (nanobind). Publisher/Subscription over the flux shared-memory
    engine, exposing borrowed frames as read-only zero-copy numpy views.
  </description>
  <maintainer email="nevlife000720@gmail.com">nevlife</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>flux_core</depend>
  <build_depend>python3-dev</build_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- flux.ros.message_filters only; flux.ros itself does not import it. -->
  <exec_depend>message_filters</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>flux_gen</test_depend>
  <test_depend>message_filters</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>sensor_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
